# Токен MAX-бота. НЕ храни его в коде — только здесь / в окружении.
# Как получить: найди @MasterBot в мессенджере MAX, создай бота
# (ник 11–60 символов, заканчивается на _bot) и забери токен.
# Для публикации нужна верификация юрлица на dev.max.ru.
MAX_BOT_TOKEN=YOUR_MAX_BOT_TOKEN

# MAX Bot API. Актуальный домен — platform-api2.max.ru.
# MAX_API_BASE_URL=https://platform-api2.max.ru

# --- Режим получения событий ---
# Пустой MAX_WEBHOOK_URL — Long Polling (разработка и тесты).
# Заполненный — Webhook (production): MAX будет слать события POST-запросами.
# Требования MAX: https://, валидный сертификат (в т.ч. УЦ Минцифры), порт 443.
# MAX_WEBHOOK_URL=https://bot.example.com
# Путь подписки и локального сервера (если в URL уже есть путь — используется он).
# MAX_WEBHOOK_PATH=/max/webhook
# Секрет подписки (5–256 символов A-Za-z0-9_-): проверяется по заголовку
# X-Max-Bot-Api-Secret каждого webhook-запроса. Настоятельно рекомендуется.
# MAX_WEBHOOK_SECRET=замени-меня-на-случайную-строку
# Порт локального webhook/health сервера (за реверс-прокси обычно 8080).
# PORT=8080

# Проверка TLS MAX API. Ошибка SSLCertVerificationError «unable to get local
# issuer certificate» означает, что в хранилище нет корневого сертификата,
# которым подписан MAX. Чаще всего это УЦ Минцифры России (Russian Trusted
# CA) — в стандартном наборе его нет, поэтому репозиторий уже содержит бандл:
# certs/max_ca_bundle.crt подхватывается автоматически.
# Другие причины (ca-certificates, прокси) — README, «TLS: сертификат MAX API».
#
# Свой бандл (путь к PEM-файлу, каталог с .crt/.pem или сам PEM-текст):
# MAX_SSL_CA_BUNDLE=/etc/ssl/certs/my_ca.pem
# Не добавлять сертификаты из certs/ (только системное хранилище):
# MAX_SSL_CA_BUNDLE=none
#
# Крайний вариант для закрытого контура — полностью отключить проверку
# сертификата (не рекомендуется, трафик становится подделываемым):
# MAX_SSL_VERIFY=false

# Группа расписания
GROUP_NAME=ЭС7-24
GROUP_ID=508
BASE_URL=http://www.ishnk.ru/2025/site/schedule/group/508
STAFF_BASE_URL=http://www.ishnk.ru/2025/site/schedule/staff
# Страница college с блоком happyCard (служебная автоматическая проверка)
BIRTHDAY_URL=http://www.ishnk.ru/2025/site
# ID MAX-чата ЭС7-24 для автоматического поздравления.
# Узнать chat_id можно из события bot_added/bot_started (см. логи отладки).
BIRTHDAY_CHAT_ID=

# Период автоматической проверки изменений (секунды). 5 минут = 300
CHECK_INTERVAL=300

# Таймаут HTTP-запроса к сайту (секунды)
HTTP_TIMEOUT=20

# Часовой пояс бота — фиксированный: Asia/Yekaterinburg (UTC+5).
# Он зашит в код (TIMEZONE = "Asia/Yekaterinburg") и НЕ читается из
# окружения, чтобы серверное время не влияло на даты.

# Rate limit
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WARNING_COOLDOWN=30

# Каталог данных (база, изображения)
DATA_DIR=data
